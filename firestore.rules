rules_version = '2';

// Todo o acesso a dados passa pelo backend (Cloud Functions via Admin SDK,
// que ignora estas regras). O cliente NUNCA fala direto com o Firestore,
// então negamos qualquer acesso direto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
